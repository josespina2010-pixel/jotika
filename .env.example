# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps JavaScript API & Places API (New).
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co).
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase key for full CRUD operations (keep private).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# SUPABASE_ANON_KEY: Optional fallback Supabase anon key if service role is not used.
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# APP_URL: The public URL where this app is hosted (AI Studio or Render).
APP_URL="MY_APP_URL"

# PORT: HTTP server port (Render injects this automatically; defaults to 3000).
PORT="3000"
